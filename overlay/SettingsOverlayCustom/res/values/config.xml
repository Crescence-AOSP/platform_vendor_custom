         {@link ComponentName}. All preference keys in a category need to be specified to guarantee
         correct behavior.-->
    <string-array name="config_order_interaction_control_services" translatable="false">
        <item>com.google.android.marvin.talkback/com.google.android.accessibility.accessibilitymenu.AccessibilityMenuService</item>
        <item>com.google.android.apps.accessibility.voiceaccess/com.google.android.apps.accessibility.voiceaccess.JustSpeakService</item>
        <item>com.google.android.marvin.talkback/com.android.switchaccess.SwitchAccessService</item>
        <item>com.google.android.accessibility.switchaccess/com.android.switchaccess.SwitchAccessService</item>
        <item>tap_assistance_preference_screen</item>
        <item>system_controls_preference_screen</item>
        <item>vibration_preference_screen</item>
        <item>physical_keyboard_a11y</item>
        <item>com.google.android.inputmethod.latin/com.google.android.libraries.inputmethod.pksimulator.settings.PkSimulatorToggleActivity</item>
        <item>pointer_and_touchpad</item>
    </string-array>

    <!-- Whether or not device header widget tile should display in device info page -->
    <bool name="config_show_device_header_in_device_info">false</bool>

    <!-- Settings intelligence package name -->
    <string name="config_settingsintelligence_package_name" translatable="false">com.google.android.settings.intelligence</string>

    <!-- Package Installer package name -->
    <string name="config_package_installer_package_name" translatable="false">com.google.android.packageinstaller</string>

    <!-- Sound picker package name -->
    <string name="config_sound_picker_package_name" translatable="false">com.google.android.soundpicker</string>

    <!-- Contacts package name -->
    <string name="config_contacts_package_name" translatable="false">com.google.android.contacts</string>

    <!-- Emergency app package name -->
    <string name="config_emergency_package_name" translatable="false">com.google.android.apps.safetyhub</string>

    <!-- Emergency app intent action -->
    <string name="config_emergency_intent_action" translatable="false">com.google.android.safetyhub.SAFETY_HUB</string>

    <!-- BT Slice intent action. To support Settings 2 panel, BT slice can't use PendingIntent.send(). Therefore, here defines the Slice intent action. -->
    <string name="config_bt_slice_intent_action" translatable="false">com.google.android.gms.nearby.discovery.ACTION_LOG_SLICE_AND_LAUNCH_INTENT</string>
    <!-- BT Slice pending intent action. To support Settings 2 panel, BT slice can't use PendingIntent.send(). Therefore, here defines the Slice pending intent action. -->
    <string name="config_bt_slice_pending_intent_action" translatable="false">com.google.android.gms.nearby.discovery.ACTION_LOG_SLICE_AND_SEND_PENDING_INTENT</string>
    <!-- BT Slice EXTRA_INTENT. To support Settings 2 panel, BT slice can't use PendingIntent.send(). Therefore, here defines the Slice EXTRA_INTENT. -->
    <string name="config_bt_slice_extra_intent" translatable="false">com.google.android.gms.nearby.discovery.EXTRA_INTENT</string>
    <!-- BT Slice EXTRA_PENDING_INTENT. To support Settings 2 panel, BT slice can't use PendingIntent.send(). Therefore, here defines the Slice EXTRA_PENDING_INTENT. -->
    <string name="config_bt_slice_extra_pending_intent" translatable="false">com.google.android.gms.nearby.discovery.EXTRA_PENDING_INTENT</string>

    <!-- Authority of advanced device battery prediction -->
    <string name="config_battery_prediction_authority" translatable="false">com.google.android.apps.turbo.bluetooth.estimated_time_remaining</string>

    <!-- Whether to enable the app battery usage list page feature. -->
    <bool name="config_app_battery_usage_list_enabled">true</bool>
</resources>
