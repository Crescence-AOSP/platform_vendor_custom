<resources>
    <!-- Whether or not lockscreen shortcuts can be customized -->
    <bool name="custom_lockscreen_shortcuts_enabled">true</bool>

    <!-- Hearing devices related tool list. Each entry must be in ComponentName format
         (package/class), indicating the specific application component to launch.
         Already contains tool that handles intent: "com.android.settings.action.live_caption" by
         default. You can add up to 2 additional related tools. -->
    <string-array name="config_quickSettingsHearingDevicesRelatedToolName" translatable="false">
        <item>com.google.audio.hearing.visualization.accessibility.scribe/com.google.audio.hearing.visualization.accessibility.scribe.MainActivity</item>
        <item>com.google.audio.hearing.visualization.accessibility.scribe/com.google.audio.hearing.visualization.accessibility.dolphin.ui.visualizer.TimelineActivity</item>
    </string-array>

    <!-- Launcher package name for overlaying icons. -->
    <string name="launcher_overlayable_package" translatable="false">com.google.android.apps.nexuslauncher</string>

    <!-- ThemePicker package name for overlaying icons. -->
    <string name="themepicker_overlayable_package" translatable="false">com.google.android.apps.wallpaper</string>

    <!-- Package name of the preferred system app to perform eSOS action -->
    <string name="config_preferredEmergencySosPackage" translatable="false">com.google.android.apps.safetyhub</string>

    <!-- Package name for the app that implements the wallpaper picker. -->
    <string name="config_wallpaperPickerPackage" translatable="false">com.google.android.apps.wallpaper</string>

    <!--
    The package name of the app store app. If empty, features using this should be gracefully
    disabled.
    -->
    <string name="config_appStorePackageName" translatable="false">com.android.vending</string>

    <!-- Template for a link that leads to an app page in the relevant app store. If empty,
    features using this should be gracefully disabled. If not empty, it must include a
    "$packageName" part that will be replaced by the code with the package name of the target app.
    -->
    <string name="config_appStoreAppLinkTemplate" translatable="false">https://play.google.com/store/apps/details?id=$packageName</string>

    <!-- List of packages for which we want to use activity info (instead of application info) for biometric prompt logo. Empty for AOSP. [DO NOT TRANSLATE] -->
    <string-array name="config_useActivityLogoForBiometricPrompt" translatable="false">
        <item>com.google.android.gms</item>
    </string-array>

    <!-- Configuration for wallpaper focal area -->
    <string name="focal_area_target" translatable="false">com.google.android.apps.magicportrait.service.MagicPortraitWallpaperService</string>
</resources>
